<?xml version="1.0" encoding="utf-8"?>
<!-- صف دواء واحد بقائمة الأدوية بصفحة الأسئلة (PQ3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_selected_option"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pill" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPendingMedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Metformin 500mg"
            android:textColor="#1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPendingMedTiming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Morning - before breakfast"
            android:textColor="#667085"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnRemovePendingMed"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="#D63031"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
