<?xml version="1.0" encoding="utf-8"?>
<!-- تفاصيل وصفة من TheMealDB: الصورة، القيم الغذائية (تقدير)، المكونات، طريقة التحضير، فيديو، وزر Add -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <include layout="@layout/toolbar_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/ivDetailImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/gym_green_light"
                android:contentDescription="Recipe photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="@color/text_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textColor="@color/text_grey"
                    android:textSize="14sp" />

                <!-- القيم الغذائية لحصة (تقدير من المكونات) + فحص السكر -->
                <TextView
                    android:id="@+id/tvDetailNutrition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:text="🍽 Nutrition (1 portion)"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDetailAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_note_box"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:text=""
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <!-- أزرار: فيديو + المصدر -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDetailVideo"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_red"
                        android:text="▶ Video"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDetailSource"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_white_outline"
                        android:text="🌐 Source"
                        android:textAllCaps="false"
                        android:textColor="@color/text_dark" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="🥕 Ingredients"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text=""
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="👩‍🍳 How to make it"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text=""
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- زر الإضافة لليومية (ثابت تحت) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDetailAdd"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_gym"
        android:text="+ Add to my food diary"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
