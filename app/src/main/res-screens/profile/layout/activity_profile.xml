<?xml version="1.0" encoding="utf-8"?>
<!-- صفحة البروفايل (حسب الصورة): صورة + اسم + عمر + 7 أقسام -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <include layout="@layout/toolbar_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- الصورة + زر الكاميرا -->
            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_circle_white_border"
                    android:contentDescription="Profile photo"
                    android:padding="0dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile" />

                <ImageView
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_green"
                    android:clickable="true"
                    android:contentDescription="Change photo"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Name"
                android:textColor="#1F2A44"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Age: - • -"
                android:textColor="#6B7A90"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvProfileSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_rest_tag"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="-"
                android:textColor="@color/gym_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cardContact"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Contact Details"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cardPhysical"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Physical Stats"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cardGoals"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Fitness Goals"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cardPreferences"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Preferences"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cardExerciseWeight"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Exercise &amp; Weight"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cardAchievements"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Achievements"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </LinearLayout>

                <TextView
                    android:id="@+id/cardHistory"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="History Overview"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
