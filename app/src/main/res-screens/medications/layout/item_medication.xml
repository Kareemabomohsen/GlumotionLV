<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F8FAF9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metformin 500mg"
                android:textColor="#1D2939"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMedTimeInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="8:00 AM - With breakfast"
                android:textColor="#667085"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMedFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Daily · Take with food"
                android:textColor="#98A2B3"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMedStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Taken"
            android:textColor="#27A765"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="6dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>