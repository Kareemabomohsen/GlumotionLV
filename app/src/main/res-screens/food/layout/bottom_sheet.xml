<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bottom_sheet_background"> <!-- خلفية زاوية دائرية من الأعلى -->

    <!-- Handle Bar for dragging -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#CBD5E0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"/>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/search_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#718096"/>

        <EditText
            android:id="@+id/etSearchFood"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search food and press Enter"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:background="@null"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:textColor="#2D3748"/>
    </LinearLayout>

    <!-- Action Buttons Row (Barcode, Search, Recipes) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnBarcode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Barcode"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <Button
            android:id="@+id/btnFoodBot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 Food Bot"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>

    <!-- My Saved Food Option -->
    <Button
        android:id="@+id/btnSavedFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Recent Foods"
        android:backgroundTint="#4A5568"
        android:textColor="#FFFFFF"/>

</LinearLayout>