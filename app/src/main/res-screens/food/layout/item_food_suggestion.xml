<?xml version="1.0" encoding="utf-8"?>
<!-- كرت اقتراح أكل صغير (كبسة = إضافة) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_cue_box"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvSuggestName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:minLines="2"
        android:text="Greek yogurt"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSuggestInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="170g • 100 kcal"
        android:textColor="@color/text_grey"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvSuggestProtein"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="17g protein"
        android:textColor="@color/purple_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="+ Add"
        android:textColor="@color/gym_green"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
