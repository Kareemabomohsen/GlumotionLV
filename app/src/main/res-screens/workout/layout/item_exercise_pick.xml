<?xml version="1.0" encoding="utf-8"?>
<!-- صف تمرين بشاشة الاختيار (كبسة = اختيار / إلغاء) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_rest_tag"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:src="@drawable/ic_dumbbell_green" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bench Press"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPickMuscle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chest"
            android:textColor="@color/text_grey"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPickCheck"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle_outline" />
</LinearLayout>
