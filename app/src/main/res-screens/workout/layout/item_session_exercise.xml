<?xml version="1.0" encoding="utf-8"?>
<!-- كرت تمرين واحد بشاشة التسجيل: العنوان + جدول السيتات + زر Add Set -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_image_small" />

            <TextView
                android:id="@+id/tvSessionExerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Lat Pulldown"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSessionExerciseTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 × 8-10 • 90s"
                android:textColor="@color/gym_purple"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- عناوين الأعمدة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="Set"
                android:textColor="@color/text_grey"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous"
                android:textColor="@color/text_grey"
                android:textSize="11sp" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="kg"
                android:textColor="@color/text_grey"
                android:textSize="11sp" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="Reps"
                android:textColor="@color/text_grey"
                android:textSize="11sp" />

            <View
                android:layout_width="34dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- صفوف السيتات بتنضاف من الجافا -->
        <LinearLayout
            android:id="@+id/setsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAddSet"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_white_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Add Set"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
