<?xml version="1.0" encoding="utf-8"?>
<!-- تمرين واحد داخل محرر الروتين: سيتات + عدات + راحة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEditExName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bench Press"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEditExMuscle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chest"
                android:textColor="@color/text_grey"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnEditExUp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move up"
            android:padding="6dp"
            android:rotation="90"
            android:src="@drawable/ic_chevron_left" />

        <ImageView
            android:id="@+id/btnEditExRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove"
            android:padding="6dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sets"
                android:textColor="@color/text_grey"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etEditExSets"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_set_input_empty"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2"
                android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reps"
                android:textColor="@color/text_grey"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etEditExReps"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_set_input_empty"
                android:digits="0123456789-"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="5"
                android:text="10" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rest (sec)"
                android:textColor="@color/text_grey"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etEditExRest"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_set_input_empty"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:text="90" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
