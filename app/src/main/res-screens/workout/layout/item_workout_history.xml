<?xml version="1.0" encoding="utf-8"?>
<!-- صف تمرين بالسجل: اليوم والساعة، اسم الروتين، المدة، المجموعات والوزن الكلي (كبسة = التفاصيل) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvHistoryDay"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circle_gym"
        android:gravity="center"
        android:text="Tue\n3"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryRoutine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Push Day"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Nov 3, 2026 • 6:10 PM"
            android:textColor="@color/text_grey"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvHistoryStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="⏱ 52 min • 15 sets • 4,250 kg"
            android:textColor="@color/gym_green"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
