<?xml version="1.0" encoding="utf-8"?>
<!-- كرت تمرين واحد بتاب الشرح (Explanation): صورة + اسم + عضلات + سيتات + نصائح + زر -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- الصورة مع زر التشغيل بالنص -->
    <FrameLayout
        android:id="@+id/frameExerciseImage"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_exercise_image"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivExerciseImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="28dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chest_triceps" />

        <ImageView
            android:id="@+id/btnPlayVideo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_circle"
            android:contentDescription="Watch video"
            android:padding="12dp"
            android:src="@drawable/ic_play" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvExerciseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Barbell Bench Press"
        android:textColor="@color/text_dark"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvExerciseMuscles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Primary: Chest • Secondary: Triceps, Shoulders"
        android:textColor="@color/text_grey"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvExerciseSetsReps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 × 8-10"
            android:textColor="@color/gym_purple"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExerciseRest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Rest: 90s"
            android:textColor="@color/text_grey"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- صندوق النصائح -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_cue_box"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Form Cues"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExerciseCues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="• Retract shoulder blades"
            android:textColor="@color/text_grey"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvExerciseProgression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Progression: Add 2.5kg when completing all reps"
        android:textColor="@color/gym_purple"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartExercise"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_gym"
        android:text="Start Bench Press Workout"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
