<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7F4"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card 5: Allergies & Dietary Restrictions -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_green"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Allergies &amp; Dietary Restrictions"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbLactose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lactose allergy" />

                <CheckBox
                    android:id="@+id/cbGluten"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gluten allergy" />

                <CheckBox
                    android:id="@+id/cbNut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nut allergy" />

                <CheckBox
                    android:id="@+id/cbHalal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Halal" />

                <CheckBox
                    android:id="@+id/cbVegan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vegan" />

                <CheckBox
                    android:id="@+id/cbVegetarian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vegetarian" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ملاحظة بتظهر بس لما الهدف تضخيم (Bulking) بدل سؤال الدايت -->
        <TextView
            android:id="@+id/tvDietSkippedNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_note_box"
            android:padding="12dp"
            android:text="Your goal is Bulking, so we skipped the diet question - a restrictive diet doesn't fit with building muscle. Your plan will use a calorie surplus with diabetic-friendly carbs."
            android:textColor="#856404"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Card 6: Dietary Preference -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDietPreference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_green"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Dietary Preference"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Your Diet"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerDiet"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 7: Sleep Schedule -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_green"
                        android:gravity="center"
                        android:text="7"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Sleep Schedule"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Help us optimize your recovery"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wake Up Time"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etWakeUpTime"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edittext"
                    android:focusable="false"
                    android:hint="07:00"
                    android:inputType="time"
                    android:paddingHorizontal="16dp"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sleep Time"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etSleepTime"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edittext"
                    android:focusable="false"
                    android:hint="23:00"
                    android:inputType="time"
                    android:paddingHorizontal="16dp"
                    android:textColor="#1A1A1A" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="Back"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2E7D32"
                android:text="continue"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>