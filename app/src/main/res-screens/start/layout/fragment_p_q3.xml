<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- البطاقة الأولى: Health Conditions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_green"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health Conditions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212529"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This helps us adapt recommendations for your safety."
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Diabetes Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diabetes Type"
                android:textStyle="bold"
                android:textColor="#343A40"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/diabetesTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="12dp"/>

            <!-- Monitoring Method -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitoring Method"
                android:textStyle="bold"
                android:textColor="#343A40"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/monitoringMethodSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="12dp"/>

            <!-- Important Note Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_note_box"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ "
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Important Note"
                        android:textStyle="bold"
                        android:textColor="#856404"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your nutrition and exercise recommendations may be adjusted based on your condition. Always consult your physician."
                    android:textColor="#856404"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- البطاقة الثانية: Medications & Dosage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_green"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medications &amp; Dosage"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212529"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track your medications and dosages"
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Medication Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medication Name"
                android:textStyle="bold"
                android:textColor="#343A40"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/medicationNameEt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:hint="e.g. Metformin"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Dosage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosage"
                android:textStyle="bold"
                android:textColor="#343A40"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/dosageEt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:hint="e.g. 500mg"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Timing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timing"
                android:textStyle="bold"
                android:textColor="#343A40"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/timingSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp"/>

            <!-- Add Medication Button -->
            <Button
                android:id="@+id/addMedicationBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#28A745"
                android:text="Add Medication"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textAllCaps="false"/>

            <!-- قائمة كل الأدوية اللي انضافت (كل دواء بينضاف للقائمة مش بس آخر واحد) -->
            <TextView
                android:id="@+id/tvMedsListTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="Your medications (0)"
                android:textStyle="bold"
                android:textColor="#343A40"/>

            <TextView
                android:id="@+id/tvNoMeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No medications added yet. You can skip this step."
                android:textColor="#6C757D"
                android:textSize="13sp"/>

            <LinearLayout
                android:id="@+id/medicationsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- أزرار الأسفل: Back و Continue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/backBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:text="Back"
                android:textColor="#212529"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/continueBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#28A745"
                android:text="continue"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>