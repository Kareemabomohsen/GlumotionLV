<?xml version="1.0" encoding="utf-8"?>
<!-- كرت إشعار: عنوان + نص + زرين (قبول / رفض) أو (اتصال / إيقاف المشاركة) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvNotifTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👥 Coach Ahmad wants to be your coach"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNotifText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ahmad@gym.com"
        android:textColor="@color/text_grey"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNotifPrimary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_gym"
            android:text="Accept"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNotifSecondary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_white_outline"
            android:text="Decline"
            android:textAllCaps="false"
            android:textColor="@color/text_dark" />
    </LinearLayout>
</LinearLayout>
