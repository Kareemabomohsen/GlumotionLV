<?xml version="1.0" encoding="utf-8"?>
<!-- لوحة المدرب (Admin): إضافة متدرب بالإيميل + تنبيهات خطر + قائمة المتدربين وحالتهم -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <include layout="@layout/toolbar_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="90dp">

            <!-- شرح قصير -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="👥 Coach Dashboard\nAdd your trainees by their email. After they accept, you can follow their blood sugar, food, workouts and medications, and you get an alert if their sugar is dangerous during training."
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddTrainee"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_gym"
                android:text="+ Add trainee by email"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- التنبيهات -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚠ Alerts"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="Clear"
                    android:textColor="@color/link_blue"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No alerts 👍"
                android:textColor="@color/text_grey"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llCoachAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- طلبات مستنية موافقة المتدرب -->
            <TextView
                android:id="@+id/tvPendingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="⏳ Waiting for approval"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- المتدربين -->
            <TextView
                android:id="@+id/tvTraineesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="👥 My trainees"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoTrainees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No trainees yet - add one with his email."
                android:textColor="@color/text_grey"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llTrainees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
