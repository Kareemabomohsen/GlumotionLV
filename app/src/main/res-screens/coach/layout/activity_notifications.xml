<?xml version="1.0" encoding="utf-8"?>
<!-- 🔔 الإشعارات (للمستخدم العادي): طلبات المدربين (قبول / رفض) + مدربيني (اتصال / إيقاف المشاركة) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <include layout="@layout/toolbar_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- طلبات المدربين -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📩 Coach requests"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No new requests"
                android:textColor="@color/text_grey"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- مدربيني -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="👥 My coaches"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoCoaches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="You don't have a coach. Your coach adds you with your email."
                android:textColor="@color/text_grey"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llCoaches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="🔒 A coach can only SEE your sugar, food, workouts and medications after you accept (he can't change them). You can stop sharing any time."
                android:textColor="@color/text_grey"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
