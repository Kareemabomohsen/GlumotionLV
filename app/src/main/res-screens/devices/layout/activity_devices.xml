<?xml version="1.0" encoding="utf-8"?>
<!-- ⌚ ساعتي: الخطوات ودقات القلب من الساعة (Health Connect) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <include layout="@layout/toolbar_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ⌚ الساعة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌚ Smart watch"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWatchStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Not connected"
                    android:textColor="@color/text_grey"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnWatchConnect"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_gym"
                    android:text="⌚ Connect watch (Health Connect)"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- شرح -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="How it works:\n⌚ Your watch is connected to the phone by its own app (Samsung Health, Fitbit, Mi Fitness...). That app puts the steps and heart rate in Health Connect, and GluMotion reads ONE total from there - watch and phone are never counted twice.\n❤ If the watch measures heart rate, it is shown at the top of the Home page."
                android:textColor="@color/text_grey"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
