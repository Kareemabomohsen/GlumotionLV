<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase needs internet, the rest timer vibrates when the rest is over -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Profile photo + meal photo for the food bot -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Reminders (Android 13+ asks the user) + restart after the phone reboots -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 🚶 Step counter of the phone (StepCounterHelper) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- ⌚ Health Connect (Android 14+): steps + heart rate from the watch (READ only) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- 🚨 SMS لجهة الطوارئ لما الحساس يشوف سكر خطير (موقوف) - لتفعيل: شيل الـ comment عن السطر اللي تحت
         (وكمل الخطوات بـ EmergencyHelper.java) -->
    <!-- <uses-permission android:name="android.permission.SEND_SMS" /> -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GluMotion">
        <!-- ⌚ ساعتي: الخطوات ودقات القلب من الساعة (Health Connect) -->
        <activity
            android:name=".devices.DevicesActivity"
            android:exported="false" />
        <!-- 🔒 شرح أذونات Health Connect (Android 14 بيفتحها من شاشة الأذونات) -->
        <activity
            android:name=".devices.HealthPrivacyActivity"
            android:exported="false" />
        <activity-alias
            android:name=".HealthPermissionsRationale"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".devices.HealthPrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- لوحة المدرب (Admin) + تفاصيل متدرب -->
        <!-- تفاصيل وصفة من TheMealDB -->
        <activity
            android:name=".recipes.RecipeDetailActivity"
            android:exported="false" />
        <activity
            android:name=".coach.CoachActivity"
            android:exported="false" />
        <activity
            android:name=".coach.NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".workout.WorkoutHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".coach.TraineeDetailActivity"
            android:exported="false" />
        <activity
            android:name=".start.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".start.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".start.CreateAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".home.HomePageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".medications.AddMedicationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".health.HealthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".food.FoodActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".workout.WorkoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".glucose.DMActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".start.ProfileQuestionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".recipes.SuggestedDishes"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".medications.MorningPills"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".medications.MedicationsActivity"
            android:exported="false" />
        <activity
            android:name=".workout.WorkoutSessionActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".workout.RestTimerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".chat.ChatBotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".food.FoodSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".workout.ExercisePickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".workout.RoutineEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".glucose.LogGlucoseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".glucose.GlucoseTrendsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".profile.ProfileListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".profile.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AlarmManager → this receiver → Notification -->
        <receiver
            android:name=".common.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>