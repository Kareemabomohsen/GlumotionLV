<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#F2F4F7" /><stroke android:width="1dp" android:color="@color/gym_border" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/white" /><stroke android:width="1dp" android:color="@color/gym_border" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
